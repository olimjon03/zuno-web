NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server only. Set a Supabase secret key (or SUPABASE_SERVICE_ROLE_KEY) to enable account deletion.
SUPABASE_SECRET_KEY=

# Server only. Enables ZUNO Assistant question routing after migration 023.
GEMINI_API_KEY=

# Public Turnstile site key. Leave blank until ready to show the widget.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Optional Kakao Maps Web SDK key for South Korean listings
NEXT_PUBLIC_KAKAO_MAP_JAVASCRIPT_KEY=
